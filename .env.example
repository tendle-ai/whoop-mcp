PUBLIC_URL=http://localhost:8081
PORT=8081
# Register PUBLIC_URL + /auth/callback in the WHOOP developer dashboard.
# Set all three together to enable OAuth. With none set, only public pages work.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Generate locally: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SIGNING_KEY=
# Private persistent directory; one worker only. Never commit its contents.
FASTMCP_HOME=.state
